{
	"name": "@leaguebrain/provenance",
	"version": "0.15.1",
	"description": "server-side SvelteKit auth",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LeagueBrain/provenance.git",
		"directory": "packages/provenance"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/LeagueBrain/provenance/issues"
	},
	"homepage": "https://github.com/LeagueBrain/provenance",
	"keywords": [
		"sveltekit",
		"authentication",
		"oauth"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"prepublishOnly": "pnpm run build"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2",
		"vite": "^7 || ^8"
	},
	"devDependencies": {
		"cookie": "1.0.2",
		"@types/node": "22",
		"dedent": "1.7.0",
		"tslib": "2.8.1",
		"tsup": "8.5.1",
		"vite": "8.0.16"
	},
	"type": "module",
	"module": "./dist/index.js",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json",
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"import": "./dist/vite/index.js"
		},
		"./sveltekit/runtime/ts": {
			"default": "./src/vite/sveltekit/runtime/ts.ts"
		},
		"./sveltekit/runtime/js": {
			"types": "./src/vite/sveltekit/runtime/js.d.ts",
			"import": "./src/vite/sveltekit/runtime/js.js"
		},
		"./providers": {
			"types": "./dist/providers/index.d.ts",
			"import": "./dist/providers/index.js"
		},
		"./initiatives": {
			"types": "./dist/initiatives/index.d.ts",
			"import": "./dist/initiatives/index.js"
		},
		"./helpers": {
			"types": "./dist/helpers/index.d.ts",
			"import": "./dist/helpers/index.js"
		},
		"./modules": {
			"types": "./dist/modules/index.d.ts",
			"import": "./dist/modules/index.js"
		}
	},
	"typesVersions": {
		"*": {
			"vite": [
				"./dist/vite/index.d.ts"
			],
			"providers": [
				"./dist/providers/index.d.ts"
			]
		}
	},
	"files": [
		"dist",
		"src/vite/**/runtime"
	]
}
